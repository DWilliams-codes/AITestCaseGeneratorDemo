# Copy this file to .env before running Docker Compose.
POSTGRES_DB=testforge
POSTGRES_USER=testforge_app
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
OPENAPI_ENABLED=true
JWT_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes-encoded-as-base64
TEST_GENERATION_PROVIDER=openai
# Required for runtime manual-test generation. Keep this secret on the backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Non-production convenience only; leave false outside an isolated demo.
TESTFORGE_DEMO_SEED_ENABLED=false
