<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
        CVE-2026-65898: DOMPurify 3.4.0 bundled in swagger-ui (JavaScript library embedded in JAR).
        CVSS score 5.1 is below the project threshold of 7.0. Suppressed because the
        embedded JavaScript is only served as Swagger UI documentation in non-production
        environments and does not process untrusted HTML in the application path.
        Review when upgrading swagger-ui to a release that bundles DOMPurify > 3.4.0.
    -->
    <suppress>
        <notes>CVE-2026-65898 DOMPurify 3.4.0 in swagger-ui; CVSS 5.1 is below project threshold of 7.0.</notes>
        <packageUrl regex="true">^pkg:javascript/DOMPurify@3\.4\.0$</packageUrl>
        <cve>CVE-2026-65898</cve>
    </suppress>
</suppressions>
